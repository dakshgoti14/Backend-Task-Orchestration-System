{
  "name": "backend-task-orchestration-system",
  "version": "1.0.0",
  "description": "Distributed Job Scheduling Platform — high-throughput, fault-tolerant, priority-aware job orchestration engine",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/WorkerNode.ts",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:stress": "jest tests/stress --runInBand --forceExit --testTimeout=60000",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint src/**/*.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node src/db/seed.ts"
  },
  "keywords": [
    "job-scheduler",
    "distributed-systems",
    "task-orchestration",
    "cron",
    "priority-queue",
    "workers",
    "redis",
    "postgresql"
  ],
  "author": "dakshgoti14",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "apollo-server-express": "^3.12.1",
    "graphql": "^16.8.1",
    "bullmq": "^5.1.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "knex": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "winston": "^3.11.0",
    "prom-client": "^15.1.0",
    "node-cron": "^3.0.3",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "joi": "^17.11.0",
    "dayjs": "^1.11.10",
    "eventemitter3": "^5.0.1",
    "p-limit": "^5.0.0",
    "p-retry": "^6.2.0",
    "redlock": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "supertest": "^6.3.3",
    "faker": "^6.6.6",
    "@faker-js/faker": "^8.3.1"
  }
}
