# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# ─── PostgreSQL ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_orchestration
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=btos:

# ─── Authentication ──────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
API_KEY_SALT_ROUNDS=12

# ─── Scheduler ───────────────────────────────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_MAX_CONCURRENT_JOBS=100
SCHEDULER_LOCK_TTL_MS=30000
LEADER_ELECTION_TTL_MS=10000

# ─── Worker ──────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=5000
WORKER_JOB_TIMEOUT_MS=300000
WORKER_HEARTBEAT_INTERVAL_MS=5000

# ─── Queue ───────────────────────────────────────────────────────────────────────
QUEUE_NAME=job_queue
DEAD_LETTER_QUEUE_NAME=dlq
MAX_QUEUE_DEPTH=10000

# ─── Monitoring ──────────────────────────────────────────────────────────────────
METRICS_PORT=9090
METRICS_PATH=/metrics
ALERT_WEBHOOK_URL=https://hooks.slack.com/your/webhook

# ─── Notifications ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
